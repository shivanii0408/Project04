<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<title>Footer</title>

<style type="text/css">

#footer {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 100%;
    background-color: #212529;
    color: #ffffff;
    text-align: center;
    padding: 12px 10px;
    border-top: 1px solid #343a40;
    box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);
    z-index: 1000;
}

#footer hr {
    width: 40%;
    border: 0;
    border-top: 1px solid #6c757d;
    margin: 0 auto 8px auto;
}

#footer h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: #f8f9fa;
}

#footer .brand {
    color: #ffffff;
    font-weight: 600;
}

#footer .copyright {
    color: *#adb5bd*;
    font-size: 12px;
    margin-top: 4px;
}

</style>

</head>

<body>

<div id="footer">

    <hr>

    <h3>
        All rights reserved by
        <span class="brand">Rays EdTech</span>,
        <span class="brand">SunilOS Infotech Pvt Ltd</span>
    </h3>

    <div class="copyright">
        &copy; 2026 All Rights Reserved
    </div>

</div>

</body>

</html>